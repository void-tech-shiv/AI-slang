{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-slang-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-17",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ],
  "observability": { "enabled": true }
}
